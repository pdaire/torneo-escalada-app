rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Sesión y roles ----

    function autenticado() {
      return request.auth != null && request.auth.token.email is string;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    // Super admin: su correo está en `admins` y viene verificado (entra con Google).
    // Una cuenta de correo y clave con ese mismo correo no basta.
    function esAdmin() {
      return autenticado()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(correo()));
    }

    function rutaMiembro(c) {
      return /databases/$(database)/documents/competencias/$(c)/miembros/$(correo());
    }

    function esMiembro(c) {
      return autenticado() && exists(rutaMiembro(c));
    }

    function rol(c) {
      return get(rutaMiembro(c)).data.rol;
    }

    function esJuez(c) {
      return esMiembro(c) && rol(c) in ['juez', 'juez_jefe'];
    }

    function esJuezJefe(c) {
      return esMiembro(c) && rol(c) == 'juez_jefe';
    }

    function esDelegado(c) {
      return esMiembro(c) && rol(c) == 'delegado';
    }

    // Administra una competencia: un admin de la plataforma o un organizador de esa competencia.
    function puedeAdministrar(c) {
      return esAdmin() || (esMiembro(c) && rol(c) == 'organizador');
    }

    function rutaEtapa(c, e) {
      return /databases/$(database)/documents/competencias/$(c)/etapas/$(e);
    }

    function rutaCompetidor(c, id) {
      return /databases/$(database)/documents/competencias/$(c)/competidores/$(id);
    }

    function etapaAbierta(c, e) {
      return exists(rutaEtapa(c, e)) && get(rutaEtapa(c, e)).data.get('estado', 'abierta') == 'abierta';
    }

    // El juez jefe anota en cualquier bloque. Un juez solo en los asignados para esa etapa.
    function puedeAnotar(c, e, b) {
      return esJuezJefe(c)
        || (esJuez(c) && b in get(rutaMiembro(c)).data.get('asignaciones', {}).get(e, []));
    }

    // ---- Resultados ----

    function intentoValido(valor, total) {
      return valor == null || (valor is int && valor >= 1 && valor <= total);
    }

    function marcadorValido(d) {
      return d.intentos is int && d.intentos >= 0 && d.intentos <= 999
        && intentoValido(d.zonaEnIntento, d.intentos)
        && intentoValido(d.topEnIntento, d.intentos)
        && (d.topEnIntento == null || (d.zonaEnIntento != null && d.zonaEnIntento <= d.topEnIntento));
    }

    // Ronda americana: hasta `maxIntentos` intentos y, si encadenó, ese fue el último intento.
    function reglasDeFormato(etapa, d) {
      return etapa.get('formato', 'wc') != 'americana'
        || (d.intentos <= etapa.get('maxIntentos', 5)
          && (d.topEnIntento == null || d.topEnIntento == d.intentos));
    }

    function escrituraResultado(id, d) {
      let campos = ['competenciaId', 'etapaId', 'competidorId', 'boulderId',
        'intentos', 'zonaEnIntento', 'topEnIntento', 'version', 'actualizadoPor', 'actualizadoEn'];
      return d.keys().hasAll(campos) && d.keys().hasOnly(campos)
        && d.competenciaId is string && d.etapaId is string
        && d.competidorId is string && d.boulderId is string
        && id == d.competenciaId + '__' + d.etapaId + '__' + d.competidorId + '__' + d.boulderId
        && marcadorValido(d)
        && d.version is int
        && d.actualizadoPor == correo()
        && d.actualizadoEn == request.time
        && etapaAbierta(d.competenciaId, d.etapaId)
        && d.boulderId in get(rutaEtapa(d.competenciaId, d.etapaId)).data.boulders
        && reglasDeFormato(get(rutaEtapa(d.competenciaId, d.etapaId)).data, d)
        && exists(rutaCompetidor(d.competenciaId, d.competidorId))
        && !(get(rutaCompetidor(d.competenciaId, d.competidorId)).data.get('categoriaId', '')
          in get(rutaEtapa(d.competenciaId, d.etapaId)).data.get('categoriasCerradas', []))
        && puedeAnotar(d.competenciaId, d.etapaId, d.boulderId);
    }

    match /resultados/{resultadoId} {
      allow read: if true;

      // `version` sube de a uno: una escritura basada en un estado viejo
      // (por ejemplo, una tablet que estuvo offline) se rechaza.
      allow create: if autenticado()
        && escrituraResultado(resultadoId, request.resource.data)
        && request.resource.data.version == 1;

      allow update: if autenticado()
        && escrituraResultado(resultadoId, request.resource.data)
        && request.resource.data.version == resource.data.get('version', 0) + 1;

      // No se borran: el historial quedaría huérfano y el resultado no se podría volver a crear.
      allow delete: if false;

      // Registro solo-agregar de cada cambio. Se escribe en el mismo batch que el resultado.
      match /historial/{entradaId} {
        allow read: if puedeAdministrar(resultadoId.split('__')[0]) || esJuez(resultadoId.split('__')[0]);

        allow create: if esJuez(resultadoId.split('__')[0])
          && request.resource.data.keys().hasOnly(['version', 'accion', 'intentos', 'zonaEnIntento', 'topEnIntento', 'autor', 'en'])
          && request.resource.data.version is int
          && entradaId == 'v' + string(request.resource.data.version)
          && request.resource.data.accion in ['intento', 'zona', 'top', 'edicion']
          && request.resource.data.autor == correo()
          && request.resource.data.en == request.time
          && getAfter(/databases/$(database)/documents/resultados/$(resultadoId)).data.version == request.resource.data.version
          && getAfter(/databases/$(database)/documents/resultados/$(resultadoId)).data.intentos == request.resource.data.intentos
          && getAfter(/databases/$(database)/documents/resultados/$(resultadoId)).data.zonaEnIntento == request.resource.data.zonaEnIntento
          && getAfter(/databases/$(database)/documents/resultados/$(resultadoId)).data.topEnIntento == request.resource.data.topEnIntento;

        allow update, delete: if false;
      }
    }

    // ---- Administradores globales (se crean a mano en la consola) ----

    match /admins/{adminId} {
      allow read: if autenticado() && adminId == correo();
      allow write: if false;
    }

    // ---- Competencias ----

    // El id de la competencia es su dirección: /copa-chile.
    match /competencias/{c} {
      allow read: if true;
      allow create, delete: if esAdmin();
      // El organizador edita los datos de su competencia, pero solo el admin la publica en la portada.
      allow update: if esAdmin()
        || (puedeAdministrar(c) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activa']));

      match /etapas/{etapaId} {
        allow read: if true;
        allow write: if puedeAdministrar(c)
          && request.resource.data.get('estado', 'abierta') in ['abierta', 'cerrada']
          && request.resource.data.get('categoriasCerradas', []) is list
          && request.resource.data.get('formato', 'wc') in ['wc', 'americana'];
        allow delete: if puedeAdministrar(c);
      }

      match /competidores/{competidorId} {
        allow read: if true;
        allow write: if puedeAdministrar(c);
      }

      match /turnos/{turnoId} {
        allow read: if true;
        allow write: if puedeAdministrar(c);
      }

      // Id = correo en minúsculas. El mismo correo puede tener otro rol en otra competencia.
      // Roles: organizador (administra la competencia), juez, juez_jefe, delegado.
      match /miembros/{miembroId} {
        allow read: if puedeAdministrar(c) || (autenticado() && miembroId == correo());
        allow create, update: if puedeAdministrar(c)
          && miembroId == miembroId.lower()
          && request.resource.data.keys().hasOnly(['rol', 'nombre', 'club', 'asignaciones'])
          && request.resource.data.rol in ['organizador', 'juez', 'juez_jefe', 'delegado']
          && request.resource.data.get('asignaciones', {}) is map;
        allow delete: if puedeAdministrar(c);
      }

      match /apelaciones/{apelacionId} {
        function apelacionValida(d) {
          return d.keys().hasOnly(['tipo', 'estado', 'argumento', 'etapaId', 'etapaNombre',
              'competidorId', 'competidorNombre', 'dorsal', 'boulderId', 'resultadoActual',
              'autorUid', 'autorEmail', 'creadaEn'])
            && d.tipo in ['resultado', 'general']
            && d.estado in ['borrador', 'en_evaluacion']
            && d.argumento is string
            && d.argumento.size() >= 10
            && d.argumento.size() <= 500
            && d.etapaId is string
            && (d.tipo == 'general' || (d.competidorId is string && d.boulderId is string));
        }

        allow read: if autenticado()
          && (resource.data.autorUid == request.auth.uid || esJuez(c) || puedeAdministrar(c));

        allow create: if esDelegado(c)
          && apelacionValida(request.resource.data)
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.autorEmail == correo()
          && request.resource.data.creadaEn == request.time
          && exists(rutaEtapa(c, request.resource.data.etapaId));

        allow update: if (
            // El delegado autor edita su borrador o lo envía a evaluación.
            esDelegado(c)
            && resource.data.autorUid == request.auth.uid
            && resource.data.estado == 'borrador'
            && apelacionValida(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipo', 'estado', 'argumento',
              'competidorId', 'competidorNombre', 'dorsal', 'boulderId', 'resultadoActual'])
          ) || (
            // Solo el juez jefe resuelve, y nunca una apelación propia.
            esJuezJefe(c)
            && resource.data.autorUid != request.auth.uid
            && resource.data.estado == 'en_evaluacion'
            && request.resource.data.estado in ['aceptada', 'rechazada']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'resueltaPor', 'resueltaEn'])
            && request.resource.data.resueltaPor == correo()
            && request.resource.data.resueltaEn == request.time
          );

        allow delete: if false;
      }
    }

    // `apelaciones` e `intentos` en la raíz son colecciones viejas: sin regla, todo se deniega.
  }
}
